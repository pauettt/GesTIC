# Base de dades PostgreSQL.
# En local, la pròpia de desenvolupament (createdb gestic_dev) i MAI la de
# producció: les dades de producció són reals i només les fa servir Vercel.
DATABASE_URL="postgresql://usuari@localhost:5432/gestic_dev"
DIRECT_URL="postgresql://usuari@localhost:5432/gestic_dev"
# A Vercel, les de Supabase:
# DATABASE_URL -> mode "Transaction pooler" (port 6543), la que fa servir l'app
#   postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL   -> mode "Direct connection" (port 5432), només per a les migracions
#   postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Opcional: connexions per instància de servidor (src/lib/db.ts). Per defecte 2
# a producció i 10 en local. Si la pàgina d'inici va lenta, es pot pujar a Vercel.
# PG_MAX_CONNECTIONS="2"

# Auth.js — clau de xifrat de sessions (genera-la amb: npx auth secret)
AUTH_SECRET=""

# Credencials OAuth de Google Cloud Console (tipus "Aplicació web")
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OBLIGATÒRIA. Domini de Google Workspace del centre: només hi entren comptes
# d'aquest domini gestionats pel Workspace. Si falta, no hi pot entrar NINGÚ, a
# propòsit: un oblit no ha d'obrir l'aplicació a qualsevol compte de Google.
GOOGLE_WORKSPACE_DOMAIN="elteucentre.cat"

# Superadministradors: els ÚNICS que poden repartir permisos des del gestor
# d'usuaris. Es defineix aquí a propòsit — qui té accés al servidor és qui mana,
# i així ningú no es pot autoascendir des de l'aplicació.
# Separats per comes: "jsteve@elteucentre.cat,altra.persona@elteucentre.cat"
# El rol es sincronitza a cada inici de sessió: qui s'hi afegeix passa a
# superadministrador i qui en surt torna a coordinador TIC. Si es deixa BUIDA no
# es degrada ningú (evita quedar-se sense superadministradors per un error de
# config).
# Hi pot haver un compte de fora del domini (p. ex. un @gmail.com): és l'únic
# extern que hi entra, i només si Google en verifica el correu. Perquè Google el
# deixi arribar fins a gesTIC, la pantalla de consentiment d'OAuth ha de ser
# «External» i estar publicada («In production»): amb «Internal», Google el
# rebutja abans (Error 403: org_internal). Vegeu el README.
ADMIN_EMAILS=""

# Adreça definitiva de l'aplicació. Mana sobre la detecció automàtica i és
# OBLIGATÒRIA en producció: d'aquí surten les URL dels codis QR enganxats als
# Chromebooks i els enllaços dels correus. Sense això, imprimir des de local o
# des d'una URL de preview deixaria els QR morts.
APP_URL="https://gestic.elteucentre.cat"

# Vercel Blob: fotos d'incidències, d'inventari i dels carros
BLOB_READ_WRITE_TOKEN=""

# Correu de sortida — avisos automàtics a la coordinació i al professorat.
# Es fa servir el Google Workspace del centre: cal una adreça del centre amb la
# verificació en dos passos activada i una CONTRASENYA D'APLICACIÓ (no la del
# compte), que es genera a https://myaccount.google.com/apppasswords
# Si es deixa buit, l'aplicació funciona igual però no envia cap correu.
SMTP_USER="gestic@elteucentre.cat"
SMTP_PASSWORD=""
# Opcional: nom que veurà qui rep el correu. Per defecte, "gesTIC <SMTP_USER>".
SMTP_FROM="gesTIC <gestic@elteucentre.cat>"
# Opcional: només cal tocar-ho si no useu Gmail (per defecte smtp.gmail.com:465)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"

# Posa-ho a "true" NOMÉS en local: activa els botons de login sense contrasenya
# per provar cada rol. En producció ha de quedar buit o absent.
ENABLE_DEV_LOGIN=""

# Protegeix les rutes /api/cron/* que crida Vercel Cron: el recordatori de
# préstecs vençuts (cada dilluns) i el ping diari que evita que Supabase pausi la
# base de dades. On ha de ser és a Vercel, que l'envia a cada crida; en local
# només cal si vols cridar aquestes rutes a mà.
# Genera'l amb: openssl rand -base64 32
# Sense aquesta variable les rutes queden TANCADES (no obertes), a propòsit.
CRON_SECRET=""

# Còpies de seguretat (npm run db:backup), només a l'ordinador de la
# coordinació. El pla gratuït de Supabase no en fa de diàries.
# BACKUP_DATABASE_URL -> la DIRECT_URL de producció, copiada de Vercel. Sense
#   ella, la tasca setmanal no fa res i ho diu al registre, en comptes de copiar
#   la base de dades local i semblar que ha anat bé. Ha de ser la del port
#   **5432**, no la del 6543: la del 6543 és el pooler en mode transacció, que
#   no manté la sessió i dona problemes amb les consultes preparades.
# BACKUP_DIR -> on es desa. Una carpeta sincronitzada amb el NAS o amb el Drive
#   del centre: una còpia al mateix ordinador no és una còpia de seguretat. Per
#   defecte, backups/ dins del projecte. El fitxer porta dades de menors.
BACKUP_DATABASE_URL=""
BACKUP_DIR=""

# Clau de xifrat de la secció Contrasenyes. Genera-la amb:
# openssl rand -base64 32
# La de Vercel xifra les contrasenyes reals: ha de ser SEMPRE la mateixa i s'ha
# de guardar també fora del servidor, perquè si es perd no es poden recuperar, i
# si es canvia, les antigues deixen de poder-se llegir. En local pot ser-ne una
# altra: les dades de `gestic_dev` són inventades.
# Sense aquesta variable la secció no desa ni mostra cap contrasenya.
VAULT_ENCRYPTION_KEY=""
