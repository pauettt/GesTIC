# Base de dades PostgreSQL a Supabase
# DATABASE_URL -> Connection string en mode "Transaction pooler" (port 6543), la que fa servir l'app en producció
# DIRECT_URL   -> Connection string en mode "Direct connection" (port 5432), només per migracions de Prisma
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Auth.js — clau de xifrat de sessions (genera-la amb: npx auth secret)
AUTH_SECRET=""

# Credencials OAuth de Google Cloud Console (tipus "Aplicació web")
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OBLIGATÒRIA. Domini de Google Workspace del centre: només hi entren comptes
# d'aquest domini gestionats pel Workspace. Si falta, no hi pot entrar NINGÚ, a
# propòsit: un oblit no ha d'obrir l'aplicació a qualsevol compte de Google.
GOOGLE_WORKSPACE_DOMAIN="elteucentre.cat"

# Superadministradors: els ÚNICS que poden repartir permisos des del gestor
# d'usuaris. Es defineix aquí a propòsit — qui té accés al servidor és qui mana,
# i així ningú no es pot autoascendir des de l'aplicació.
# Separats per comes: "jsteve@elteucentre.cat,altra.persona@elteucentre.cat"
# El rol es sincronitza a cada inici de sessió: qui s'hi afegeix passa a
# superadministrador i qui en surt torna a coordinador TIC. Si es deixa BUIDA no
# es degrada ningú (evita quedar-se sense superadministradors per un error de
# config).
ADMIN_EMAILS=""

# Adreça definitiva de l'aplicació. Mana sobre la detecció automàtica i és
# OBLIGATÒRIA en producció: d'aquí surten les URL dels codis QR enganxats als
# Chromebooks i els enllaços dels correus. Sense això, imprimir des de local o
# des d'una URL de preview deixaria els QR morts.
APP_URL="https://gestic.elteucentre.cat"

# Vercel Blob: fotos d'incidències, d'inventari i dels carros
BLOB_READ_WRITE_TOKEN=""

# Correu de sortida — avisos automàtics a la coordinació i al professorat.
# Es fa servir el Google Workspace del centre: cal una adreça del centre amb la
# verificació en dos passos activada i una CONTRASENYA D'APLICACIÓ (no la del
# compte), que es genera a https://myaccount.google.com/apppasswords
# Si es deixa buit, l'aplicació funciona igual però no envia cap correu.
SMTP_USER="gestic@elteucentre.cat"
SMTP_PASSWORD=""
# Opcional: nom que veurà qui rep el correu. Per defecte, "gesTIC <SMTP_USER>".
SMTP_FROM="gesTIC <gestic@elteucentre.cat>"
# Opcional: només cal tocar-ho si no useu Gmail (per defecte smtp.gmail.com:465)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"

# Posa-ho a "true" NOMÉS en local: activa els botons de login sense contrasenya
# per provar cada rol. En producció ha de quedar buit o absent.
ENABLE_DEV_LOGIN=""

# Protegeix les rutes /api/cron/* que crida Vercel Cron: el recordatori de
# préstecs vençuts (cada dilluns) i el ping diari que evita que Supabase pausi la
# base de dades. On ha de ser és a Vercel, que l'envia a cada crida; en local
# només cal si vols cridar aquestes rutes a mà.
# Genera'l amb: openssl rand -base64 32
# Sense aquesta variable les rutes queden TANCADES (no obertes), a propòsit.
CRON_SECRET=""
