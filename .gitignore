# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
# Sessions de prova i identificadors que genera cada execució dels e2e
/e2e/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# La plantilla sí que va al repositori: sense ella, qui cloni el projecte no sap
# quines variables calen. Abans `.env*` també se l'enduia i no s'havia pujat mai.
!.env.example

# Còpies de seguretat de les dades reals (npm run db:backup). Porten dades
# personals, també de menors: no han d'anar mai al repositori.
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
