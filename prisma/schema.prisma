generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth v5 — Prisma adapter tables)
// ---------------------------------------------------------------------------

// SUPER_ADMIN: designat per ADMIN_EMAILS al servidor; és l'únic que pot donar i
// treure permisos des del gestor d'usuaris.
// ADMIN: coordinació TIC del dia a dia (incidències, inventari, carros...).
// CONSERGERIA: compte únic compartit pels conserges. NOMÉS veu el control de
//   claus; qui entrega cada clau es registra a part (model Concierge), perquè
//   poden ser-hi tots tres alhora amb la mateixa sessió oberta.
// PROFESSOR: usuari del centre.
enum Role {
  SUPER_ADMIN
  ADMIN
  CONSERGERIA
  PROFESSOR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(PROFESSOR)
  // Tutor/a de grup. No és un rol: és una característica que se suma al que ja
  // té (un coordinador TIC també pot ser tutor d'un grup). La dona i la treu el
  // super admin des de /usuaris, i és qui pot demanar Chromebooks en préstec
  // per a l'alumnat del seu grup.
  isTutor       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?

  accounts Account[]
  sessions Session[]

  reportedIncidents     Incident[]           @relation("IncidentReporter")
  assignedIncidents     Incident[]           @relation("IncidentAssignee")
  incidentComments      IncidentComment[]
  reservations          Reservation[]
  trainingEnrollments   TrainingEnrollment[]
  chromebookNotes       ChromebookNote[]
  queries               Query[]
  queryComments         QueryComment[]
  loanRequests          LoanRequest[]        @relation("LoanRequester")
  respondedLoanRequests LoanRequest[]        @relation("LoanResponder")
  keyLoans              KeyLoan[]            @relation("KeyBorrower")

  studentDeviceRequests   StudentDeviceRequest[] @relation("StudentDeviceTutor")
  respondedStudentDevices StudentDeviceRequest[] @relation("StudentDeviceResponder")
  appointments            Appointment[]
  openedAppointmentSlots  AppointmentSlot[]      @relation("AppointmentSlotOpener")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Ubicacions físiques (reutilitzades per inventari i incidències)
// ---------------------------------------------------------------------------

model Space {
  id       String  @id @default(cuid())
  name     String
  building String?
  floor    String?

  inventoryItems   InventoryItem[]
  carts            Cart[]
  chromebooks      Chromebook[]
  trainingSessions TrainingSession[]
  incidents        Incident[]

  @@unique([name])
}

// ---------------------------------------------------------------------------
// Inventari TIC de centre
// ---------------------------------------------------------------------------

enum InventoryItemStatus {
  ACTIU
  EN_REPARACIO
  BAIXA
}

// Categories de material d'inventari, gestionades pel coordinador/a TIC
// (a "Inventari TIC" mateix) — permet afegir tipus nous (iPad, rotlladors...)
// sense necessitat de canviar el codi ni desplegar de nou.
model InventoryCategory {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)

  items InventoryItem[]
}

model InventoryItem {
  id            String              @id @default(cuid())
  categoryId    String
  brand         String
  model         String
  serialNumber  String?             @unique
  spaceId       String?
  status        InventoryItemStatus @default(ACTIU)
  imageUrl      String?
  // Si es pot deixar en préstec al professorat (ex: portàtils, iPads) o si és
  // material fix de l'aula que no es presta (ex: un projector muntat al sostre).
  isLoanable    Boolean             @default(false)
  purchaseDate  DateTime?
  warrantyUntil DateTime?
  notes         String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  category     InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  space        Space?            @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  incidents    Incident[]
  loanRequests LoanRequest[]

  @@index([spaceId])
  @@index([categoryId])
  @@index([isLoanable])
}

// ---------------------------------------------------------------------------
// Préstecs de material prestable de l'inventari al professorat
// ---------------------------------------------------------------------------

enum LoanRequestStatus {
  PENDENT
  APROVADA
  REBUTJADA
  RETORNADA
  CANCELLADA
}

model LoanRequest {
  id            String            @id @default(cuid())
  itemId        String
  requesterId   String
  startDate     DateTime
  endDate       DateTime
  purpose       String?
  status        LoanRequestStatus @default(PENDENT)
  responseNote  String?           @db.Text
  respondedById String?
  respondedAt   DateTime?
  // Data real de retorn: `endDate` només és la data prevista, i cal poder veure
  // a la fitxa de l'equip si un préstec es va tornar tard.
  returnedAt    DateTime?
  createdAt     DateTime          @default(now())

  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  requester   User          @relation("LoanRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  respondedBy User?         @relation("LoanResponder", fields: [respondedById], references: [id], onDelete: SetNull)

  @@index([itemId, startDate, endDate])
  @@index([requesterId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Carros de Chromebooks
// ---------------------------------------------------------------------------

// ASSIGNAT: equip del pool de préstec individual que ara té un alumne a casa.
// És un estat a part de RESERVAT (que és de carro, per hores) perquè dura tot
// el curs i no el pot alliberar cap horari: només es tanca amb la devolució.
enum ChromebookStatus {
  DISPONIBLE
  RESERVAT
  ASSIGNAT
  EN_INCIDENCIA
  BAIXA
}

model Cart {
  id           String  @id @default(cuid())
  name         String  @unique
  serialNumber String? @unique
  spaceId      String?
  imageUrl     String?

  space        Space?        @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  chromebooks  Chromebook[]
  reservations Reservation[]
  incidents    Incident[]
  keys         Key[]

  @@index([spaceId])
}

model Chromebook {
  id                String           @id @default(cuid())
  // cartId és opcional per poder representar un Chromebook temporalment fora
  // d'un carro (taller, magatzem...) — la ubicació exacta per a aquest cas
  // (Espai) encara està per definir; de moment els Chromebooks es creen i
  // gestionen sempre dins del context d'un carro concret.
  cartId            String?
  spaceId           String?
  assetTag          String           @unique
  serialNumber      String?          @unique
  brand             String?
  model             String?
  status            ChromebookStatus @default(DISPONIBLE)
  // Equip del pool de préstec individual a l'alumnat. No és el mateix que tenir
  // `cartId` buit: això vol dir "ara mateix fora del carro" (taller, magatzem)
  // i l'equip hi ha de tornar. Els del pool no són de cap carro mai, perquè si
  // en sortissin d'un, les reserves d'aula deixarien de quadrar sense que ningú
  // se n'adonés fins que falten equips a classe.
  isStudentLoanable Boolean          @default(false)

  cart            Cart?                  @relation(fields: [cartId], references: [id], onDelete: SetNull)
  space           Space?                 @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  incidents       Incident[]
  notes           ChromebookNote[]
  studentRequests StudentDeviceRequest[]

  @@index([cartId])
  @@index([spaceId])
  @@index([isStudentLoanable])
}

// Historial de notes datades d'un Chromebook (avaries, reparacions, seguiment...).
model ChromebookNote {
  id           String   @id @default(cuid())
  chromebookId String
  authorId     String
  body         String   @db.Text
  createdAt    DateTime @default(now())

  chromebook Chromebook @relation(fields: [chromebookId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([chromebookId])
}

enum ReservationStatus {
  CONFIRMADA
  CANCELLADA
  COMPLETADA
}

model Reservation {
  id        String            @id @default(cuid())
  cartId    String
  userId    String
  startDate DateTime
  endDate   DateTime
  purpose   String?
  status    ReservationStatus @default(CONFIRMADA)
  createdAt DateTime          @default(now())

  cart     Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyLoans KeyLoan[]

  @@index([cartId, startDate, endDate])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Préstec de Chromebooks a l'alumnat, demanat pels tutors
// ---------------------------------------------------------------------------

/// Per què un alumne necessita un equip. És una llista tancada i no text lliure
/// a propòsit: aquests motius voregen situacions familiars, i un camp obert
/// convida a escriure-hi coses que després no caldria tenir desades enlloc. El
/// comentari que l'acompanya serveix per matisar, i només cal a ALTRE.
enum StudentDeviceReason {
  SENSE_DISPOSITIU
  DISPOSITIU_AVARIAT
  NECESSITAT_EDUCATIVA
  ALTRE
}

/// RETORNADA hi és des del primer dia encara que de moment no la posi ningú:
/// afegir un valor a un enum de Postgres demana una migració a part, i el cicle
/// sencer (demanar → decidir → tornar) ja està decidit.
enum StudentDeviceRequestStatus {
  PENDENT
  APROVADA
  REBUTJADA
  RETORNADA
  CANCELLADA
}

/// Sol·licitud d'un tutor perquè un alumne del seu grup tingui un Chromebook
/// durant el curs. En aprovar-la s'hi assigna un equip del pool
/// (`Chromebook.isStudentLoanable`), que passa a ASSIGNAT fins a la devolució.
///
/// Les dades de l'alumne són d'un menor i només les veuen el tutor que ha fet
/// la sol·licitud i la coordinació TIC. No s'hi desa cap identificador acadèmic
/// (expedient, document): amb el nom i el grup n'hi ha prou per saber de qui
/// es parla, i tota la resta seria guardar dades per guardar-les.
model StudentDeviceRequest {
  id               String                     @id @default(cuid())
  tutorId          String
  studentFirstName String
  studentLastName  String
  groupName        String?
  reason           StudentDeviceReason
  reasonNote       String?                    @db.Text
  status           StudentDeviceRequestStatus @default(PENDENT)
  chromebookId     String?
  responseNote     String?                    @db.Text
  respondedById    String?
  respondedAt      DateTime?
  returnedAt       DateTime?
  createdAt        DateTime                   @default(now())

  tutor       User        @relation("StudentDeviceTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  respondedBy User?       @relation("StudentDeviceResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  chromebook  Chromebook? @relation(fields: [chromebookId], references: [id], onDelete: SetNull)

  @@index([tutorId])
  @@index([status])
  @@index([chromebookId])
}

// ---------------------------------------------------------------------------
// Incidències TIC
// ---------------------------------------------------------------------------

enum IncidentTargetType {
  INVENTORY_ITEM
  CHROMEBOOK
  CART
  GOOGLE_WORKSPACE
  GENERAL
}

enum IncidentPriority {
  BAIXA
  MITJANA
  ALTA
}

enum IncidentCategory {
  PANTALLA
  TECLAT
  TOUCHPAD
  WIFI_INTERNET
  NO_S_ENCEN
  ALTRE
}

// Servei de l'entorn Google afectat. Va en un enum a part de IncidentCategory
// perquè aquella descriu avaries de maquinari (pantalla, teclat...) i s'ofereix
// al formulari ràpid del QR dels Chromebooks.
enum GoogleService {
  CLASSROOM
  COMPTE
  GMAIL
  DRIVE
  MEET
  CALENDAR
  YOUTUBE
  CHROME
  ALTRE
}

enum IncidentStatus {
  OBERTA
  EN_CURS
  RESOLTA
  TANCADA
}

model Incident {
  id              String             @id @default(cuid())
  reporterId      String
  targetType      IncidentTargetType
  spaceId         String?
  inventoryItemId String?
  chromebookId    String?
  cartId          String?
  googleService   GoogleService?
  title           String
  description     String             @db.Text
  category        IncidentCategory?
  priority        IncidentPriority   @default(MITJANA)
  status          IncidentStatus     @default(OBERTA)
  assignedToId    String?
  createdAt       DateTime           @default(now())
  resolvedAt      DateTime?

  reporter      User                 @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assignedTo    User?                @relation("IncidentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  space         Space?               @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  inventoryItem InventoryItem?       @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  chromebook    Chromebook?          @relation(fields: [chromebookId], references: [id], onDelete: SetNull)
  cart          Cart?                @relation(fields: [cartId], references: [id], onDelete: SetNull)
  comments      IncidentComment[]
  attachments   IncidentAttachment[]

  @@index([status, priority])
  @@index([reporterId])
}

model IncidentComment {
  id         String   @id @default(cuid())
  incidentId String
  authorId   String
  body       String   @db.Text
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model IncidentAttachment {
  id         String   @id @default(cuid())
  incidentId String
  url        String
  filename   String
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

// ---------------------------------------------------------------------------
// Formació del professorat
// ---------------------------------------------------------------------------

model TrainingSession {
  id           String   @id @default(cuid())
  title        String
  description  String   @db.Text
  date         DateTime
  spaceId      String?
  capacity     Int?
  materialsUrl String[] @default([])
  createdAt    DateTime @default(now())

  space       Space?               @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  enrollments TrainingEnrollment[]

  @@index([date])
}

model TrainingEnrollment {
  id         String   @id @default(cuid())
  sessionId  String
  userId     String
  enrolledAt DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

// ---------------------------------------------------------------------------
// Dubtes del professorat (FAQ)
// ---------------------------------------------------------------------------

model FaqEntry {
  id       String @id @default(cuid())
  question String
  answer   String @db.Text
  category String
  order    Int    @default(0)

  @@index([category])
}

// ---------------------------------------------------------------------------
// Consultes del professorat (dubtes personals, no preguntes freqüents)
// ---------------------------------------------------------------------------

enum QueryStatus {
  OBERTA
  EN_CURS
  RESOLTA
  TANCADA
}

model Query {
  id          String      @id @default(cuid())
  authorId    String
  title       String
  description String      @db.Text
  status      QueryStatus @default(OBERTA)
  createdAt   DateTime    @default(now())
  resolvedAt  DateTime?

  author   User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments QueryComment[]

  @@index([status])
  @@index([authorId])
}

model QueryComment {
  id        String   @id @default(cuid())
  queryId   String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  query  Query @relation(fields: [queryId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([queryId])
}

// ---------------------------------------------------------------------------
// Instruccions i tutorials
// ---------------------------------------------------------------------------

model TutorialCategory {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)

  articles TutorialArticle[]
}

model TutorialArticle {
  id              String   @id @default(cuid())
  categoryId      String
  title           String
  slug            String   @unique
  contentMarkdown String   @db.Text
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  category TutorialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Consergeria: claus del centre
// ---------------------------------------------------------------------------

/**
 * Nom d'un conserge. NO és un usuari amb contrasenya: consergeria comparteix un
 * únic compte de domini i poden ser-hi tots tres alhora, així que qui entrega
 * una clau es tria amb un clic en el moment de fer-ho. Els manté el super admin.
 */
model Concierge {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveredLoans KeyLoan[] @relation("KeyDeliveredBy")
  sentReminders  KeyLoan[] @relation("KeyReminderBy")
}

/**
 * Clau física del centre. `cartId` només el tenen les dels carros de
 * Chromebooks: aquelles hereten les reserves, i per això se'n pot saber a quina
 * hora havien de tornar. Les d'aula o magatzem no en tenen cap.
 */
model Key {
  id        String   @id @default(cuid())
  number    String   @unique
  name      String
  cartId    String?
  copies    Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())

  cart  Cart?     @relation(fields: [cartId], references: [id], onDelete: SetNull)
  loans KeyLoan[]

  @@index([cartId])
}

model KeyLoan {
  id            String    @id @default(cuid())
  keyId         String
  borrowerId    String
  deliveredById String
  deliveredAt   DateTime  @default(now())
  returnedAt    DateTime?
  // Reserva que justifica el préstec. Absent quan es dona la clau sense
  // reserva: una urgència, un substitut... Es registra igualment, perquè si el
  // sistema no ho permetés el conserge donaria la clau i no ho apuntaria.
  reservationId String?
  reason        String?
  // Avís manual a qui no ha tornat la clau. Es desa qui l'ha enviat i quan
  // perquè els tres conserges no bombardegin el mateix professor.
  remindedAt    DateTime?
  remindedById  String?

  key         Key          @relation(fields: [keyId], references: [id], onDelete: Cascade)
  borrower    User         @relation("KeyBorrower", fields: [borrowerId], references: [id], onDelete: Cascade)
  deliveredBy Concierge    @relation("KeyDeliveredBy", fields: [deliveredById], references: [id])
  remindedBy  Concierge?   @relation("KeyReminderBy", fields: [remindedById], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([keyId, returnedAt])
  @@index([borrowerId])
}

// ---------------------------------------------------------------------------
// Cites amb la coordinació TIC
// ---------------------------------------------------------------------------

/**
 * Hora que la coordinació TIC obre de la seva disponibilitat perquè algú del
 * claustre hi demani cita. Es marquen una per una damunt la graella de l'horari
 * del centre: la gràcia és justament que només hi siguin les hores en què la
 * coordinació hi pot ser, no totes.
 * `startDate`/`endDate` surten de combinar el dia amb una sessió de
 * `SCHOOL_PERIODS`, igual que les reserves de carro. `startDate` és únic: una
 * hora, una cita.
 */
model AppointmentSlot {
  id         String   @id @default(cuid())
  startDate  DateTime @unique
  endDate    DateTime
  // Qui de coordinació l'ha obert. A coordinació hi som tres, i qui demana
  // l'hora ha de saber amb qui la té.
  openedById String?
  createdAt  DateTime @default(now())

  openedBy    User?        @relation("AppointmentSlotOpener", fields: [openedById], references: [id], onDelete: SetNull)
  appointment Appointment?
}

/**
 * Cita d'algú del claustre en una hora oberta. El motiu és text lliure: passar
 * el sociograma de la tutoria és el primer ús que se li dona, però l'agenda
 * serveix per a qualsevol cosa que s'hagi de fer amb la coordinació.
 * Cancel·lar-la l'esborra i l'hora torna a quedar lliure; no es guarda historial
 * de cancel·lades perquè no hi ha res a reclamar-ne després.
 */
model Appointment {
  id        String   @id @default(cuid())
  slotId    String   @unique
  userId    String
  purpose   String
  createdAt DateTime @default(now())

  slot AppointmentSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
